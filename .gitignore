# Whitelist release: ignore everything, then allow only the public release.
/*
!/.gitignore
!/README.md
!/README.zh-CN.md
!/LICENSE
!/NOTICE
!/THIRD_PARTY_LICENSES.md
!/CITATION.cff
!/requirements.txt
!/requirements-benchmarks.txt

# Core source and current scripts
!/src/
!/src/*.py
!/scripts/
!/scripts/*.py
!/scripts/*.sh
# Internal cluster/sync tooling kept locally but not published
/scripts/serve_tap_feedback.py
# Tests, docs, example configs
!/tests/
!/tests/*.py
# Depends on benchmark assets and nltk, which are not in the code release
/tests/test_benign_benchmarks.py
!/docs/
!/docs/*.md
!/configs/
!/configs/README.md
!/configs/judge_pool.example.json

# Public source provenance for the speculative-variant adapters.  The upstream
# trees themselves stay local because they contain large assets and nested Git
# metadata; SOURCES.json records their exact commits and licences.
!/third_party/
/third_party/*
!/third_party/speculative_variants/
/third_party/speculative_variants/*
!/third_party/speculative_variants/README.md
!/third_party/speculative_variants/SOURCES.json
!/third_party/speculative_variants/PATCHES.md

# Only the split file and its README from data/
!/data/
/data/*
!/data/README.md
!/data/harmbench_split.json

# Only the frozen aggregate evidence from results/
!/results/
/results/*
!/results/README.md
!/results/paper_evidence_20261011/
!/results/paper_evidence_20261011/**
!/results/security_variants_20261122/
/results/security_variants_20261122/*
!/results/security_variants_20261122/README.md
!/results/security_variants_20261122/registry.json
!/results/security_variants_20261122/campaign_plan.json
!/results/security_variants_20261122/model_matrix.json
!/results/security_variants_20261122/head_artifacts.json
!/results/security_variants_20261122/distribution.json
!/results/security_variants_20261122/deployment_verification.json
!/results/security_variants_20261122/analysis/
!/results/security_variants_20261122/analysis/spec_variant_security.json
!/results/security_variants_20261122/analysis/spec_variant_security.csv
!/results/security_variants_20261122/analysis/spec_variant_mechanism.json

# Never publish caches
__pycache__/
*.py[cod]
.pytest_cache/
